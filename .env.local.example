# ui-sbs-viwer 환경설정 템플릿 — 복사해서 사용:  cp .env.local.example .env.local
# .env.local 은 gitignore 됨. 이 파일(.env.local.example)만 커밋한다.
# ⚠️ 실제 호스트/IP/계정/버킷/시크릿은 여기 적지 않는다. 전부 placeholder — 실값은 .env.local 에만.

# ── DB (MariaDB, 읽기 전용) ──
# 운영: SELECT 전용 계정 + 같은 VPC 사설 IP. 이 앱은 DB 에 쓰지 않는다(렌더 기록은 agent-compose 담당).
# 로컬 dev: 개발용 계정 + 공인 EIP (운영 계정은 사설 대역에서만 접속 허용이라 로컬에서 못 씀).
DB_HOST=<db-host>
DB_PORT=<db-port>
DB_USER=<db-user>
DB_PW=                       # 커밋 금지 — .env.local 에만
DB_NAME=<db-name>

# ── agent-compose (편성 파이프라인) ──
# POST /api/v1/compose (202 job_id) → GET /api/v1/compose/{job_id} 폴링
# POST /api/v1/render  (동기, worker-render 기동 시에만 성공)
# GET  /api/v1/ingest?v_id=
COMPOSE_BASE_URL=<compose-base-url>   # 예: http://<agent-host>:<port> (끝 슬래시 없이)
# 편성 폴링 타임아웃(ms). 실측 1~3분.
COMPOSE_TIMEOUT_MS=600000
# 렌더 요청 타임아웃(ms). agent-compose 자체 상한이 600초.
RENDER_TIMEOUT_MS=660000

# ── AWS S3 (렌더 산출물 읽기 전용) ──
# 재생·내려받기는 result/{v_id}/{v_id}_{c_id}.mp4 를 presigned GET 으로만 제공한다.
AWS_REGION=<aws-region>
S3_BUCKET=<s3-bucket-name>
# presigned URL 유효시간(초).
#   S3_PRESIGN_TTL — 내려받기용. 짧게 유지한다(PAGES.md §6).
#   S3_PLAY_TTL    — 재생용. <video> 는 탐색·버퍼링마다 재요청하므로 원본 길이(3~4시간)를 감안해 길게.
S3_PRESIGN_TTL=600
S3_PLAY_TTL=3600
# 자격증명:
#   · 로컬 dev: MFA 세션 프로필 (source ~/.claude/scripts/aws-mfa-auth.sh → AWS_PROFILE=mfa)
#   · 운영: EC2 인스턴스 롤(GetObject 만) — 키 불필요(권장)
# AWS_PROFILE=

# ── 썸네일 (원본에서 프레임 1장 추출 → 로컬 캐시) ──
# ffmpeg 필요. AL2023 는 기본 저장소에 없어 정적 빌드를 /usr/local/bin 에 둔다.
FFMPEG_PATH=ffmpeg
THUMB_CACHE_DIR=./.cache/thumbs

# ── 로깅 ──
LOG_LEVEL=info               # debug | info | warn | error
# LOG_FILE — 설정 시 해당 파일에 append(절대경로 권장). 미설정이면 콘솔 전용.
# LOG_FILE=/usr/service/logs/scenemaker/ui-sbs/web.log
